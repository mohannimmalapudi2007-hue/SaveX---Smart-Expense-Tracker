# SaveX Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB)
# If local/remote MongoDB is unreachable during development, an in-memory MongoDB instance will be used automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/savex

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_long
JWT_EXPIRES_IN=7d

# Client Application URL (CORS origin whitelist)
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for SaveX Smart Assistant
# If omitted, SaveX operates with its built-in rule-based financial reasoning engine.
GEMINI_API_KEY=
